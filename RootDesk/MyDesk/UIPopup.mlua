@Logic
script UIPopup extends Logic

	property TextComponent message = "3606e39d-32de-427e-8d23-b38af810a3b4"
	property ButtonComponent btnOk = "94a274e4-4111-40f1-924d-c95a3a1f14d5"
	property ButtonComponent btnCancel = "0f5de49b-2adc-409a-816d-15aa43df8e0d"
	property Entity popupGroup = "fb7a3b06-7026-4590-8efe-bb33416dd8f9"
	property Entity popup = "aa954759-0e39-430f-85fa-80bf2e5fe31d"
	property any onOk = nil
	property any onCancel = nil
	property number duration = 0.15
	property number from = 0.5
	property number to = 1
	property boolean isOpen = false
	property boolean isPending = false
	property boolean isClosing = false
	property boolean isTweenPlaying = false
	property integer popupSession = 0
	property any okHandler = nil
	property any cancelHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 엔티티/로직 수명의 참조와 시작 상태를 초기화한다.
		self.popupGroup.Enable = false
	end

	@ExecSpace("ClientOnly")
	method void Open(string text, any onOk, any onCancel)
		-- 승인 대기부터 새 전투 입력을 차단하고 서버 정지 후에만 팝업을 표시한다.
		if self.isOpen or not isvalid(self.popupGroup) or not isvalid(self.popup) then return end
		self.isOpen = true
		self.isPending = true
		self.isClosing = false
		self.popupSession = self.popupSession + 1
		self._T.releaseRequested = false
		self.message.Text = text
		self.onOk = onOk
		self.onCancel = onCancel
		local control = _CombatInputController:GetStateControl()
		if isvalid(control) then control:SetPopupInputBlocked(true) end
		self._T.player = _UserService.LocalPlayer
		self._T.map = isvalid(self._T.player) and self._T.player.CurrentMap or nil
		self._T.pause = nil
		if isvalid(self._T.map) then self._T.pause = self._T.map:GetComponent("script.CombatPauseComponent") end
		if isvalid(self._T.pause) then
			self._T.pause:RequestPopupPause(self.popupSession, true)
		else
			self:ShowPopup()
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowPopup()
		-- 서버 승인 후 기존 팝업의 버튼과 표시 연출을 연결한다.
		self.isPending = false
		if self.isClosing then self:CompleteClose(); return end
		self.popupGroup.Enable = true
		self.okHandler = self.btnOk.Entity:ConnectEvent(ButtonClickEvent, self.OnClickOk)
		self.cancelHandler = self.btnCancel.Entity:ConnectEvent(ButtonClickEvent, self.OnClickCancel)
		self:StartTween(true)
	end

	@ExecSpace("ClientOnly")
	method void OnPauseResponse(any pause, integer session, boolean accepted, boolean paused)
		-- 이전 세션의 응답은 새 팝업이나 시간 배율을 변경하지 못한다.
		if not self.isOpen or pause ~= self._T.pause or session ~= self.popupSession then return end
		if not accepted then self:AbortPopup(); return end
		if paused then
			if not self.isPending then return end
			pause:SetPresentationPaused(true)
			self:ShowPopup()
		else
			self:FinishPopup()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnClickOk()
		-- 확인 콜백을 한 번만 꺼내고 닫기부터 시작한다.
		if not self.isOpen or self.isPending or self.isClosing or self.isTweenPlaying then return end
		local callback = self.onOk
		self:Close()
		if callback ~= nil then callback() end
	end

	@ExecSpace("ClientOnly")
	method void OnClickCancel()
		-- 취소 콜백을 한 번만 꺼내고 닫기부터 시작한다.
		if not self.isOpen or self.isPending or self.isClosing or self.isTweenPlaying then return end
		local callback = self.onCancel
		self:Close()
		if callback ~= nil then callback() end
	end

	@ExecSpace("ClientOnly")
	method void DisconnectButtons()
		-- 이벤트 연결과 양쪽 콜백 참조를 함께 해제한다.
		if self.okHandler ~= nil and isvalid(self.btnOk) then self.btnOk.Entity:DisconnectEvent(ButtonClickEvent, self.okHandler) end
		if self.cancelHandler ~= nil and isvalid(self.btnCancel) then self.btnCancel.Entity:DisconnectEvent(ButtonClickEvent, self.cancelHandler) end
		self.okHandler = nil
		self.cancelHandler = nil
		self.onOk = nil
		self.onCancel = nil
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 중복 닫기를 무시하고 단일 닫기 연출을 시작한다.
		if not self.isOpen or self.isClosing then return end
		self.isClosing = true
		self:DisconnectButtons()
		if self.isPending then return end
		self:StartTween(false)
	end

	@ExecSpace("ClientOnly")
	method void StopTween()
		-- 정지 가능한 TimerService 대신 소유한 실시간 연출 상태만 해제한다.
		self._T.tween = nil
		self.isTweenPlaying = false
	end

	@ExecSpace("ClientOnly")
	method void StartTween(boolean opening)
		-- UI 연출은 클라이언트 시간 배율과 무관한 실시간으로 갱신한다.
		self:StopTween()
		self.isTweenPlaying = true
		self._T.tween = { transform = self.popup.UITransformComponent, canvas = self.popupGroup.CanvasGroupComponent,
			started = _UtilLogic.ElapsedSeconds, duration = math.max(0.001, self.duration), opening = opening }
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Logic 갱신 호출은 시간 배율 0에서도 오므로 비스케일 실시간으로 UI만 진행한다.
		if self.isOpen and isvalid(self._T.pause) then
			local player = _UserService.LocalPlayer
			if player ~= self._T.player or not isvalid(player) or player.CurrentMap ~= self._T.map then self:AbortPopup(); return end
		end
		local tween = self._T.tween
		if tween == nil then return end
		if not isvalid(tween.transform) or not isvalid(tween.canvas) then self:AbortPopup(); return end
		local elapsed = math.min(tween.duration, _UtilLogic.ElapsedSeconds - tween.started)
		local time = tween.opening and elapsed or tween.duration - elapsed
		local scale = _TweenLogic:Ease(self.from, self.to, tween.duration, EaseType.SineEaseIn, time)
		tween.transform.UIScale = Vector3(scale, scale, 1)
		tween.canvas.GroupAlpha = time / tween.duration
		if elapsed >= tween.duration then
			self:StopTween()
			if not tween.opening then self:CompleteClose() end
		end
	end

	@ExecSpace("ClientOnly")
	method void CompleteClose()
		-- 서버 정지를 유지한 채 홀드를 비운 다음 같은 세션의 재개를 요청한다.
		if self._T.releaseRequested then return end
		self._T.releaseRequested = true
		self.isPending = false
		if isvalid(self.popupGroup) then self.popupGroup.Enable = false end
		local control = _CombatInputController:GetStateControl()
		if isvalid(control) then control:PreparePopupResume() end
		if isvalid(self._T.pause) then
			self._T.pause:RequestPopupPause(self.popupSession, false)
		else
			self:FinishPopup()
		end
	end

	@ExecSpace("ClientOnly")
	method void FinishPopup()
		-- 재개 승인 후에만 클라이언트 연출과 입력 게이트를 해제한다.
		self:StopTween()
		self:DisconnectButtons()
		if isvalid(self._T.pause) then self._T.pause:SetPresentationPaused(false) end
		if isvalid(self.popupGroup) then self.popupGroup.Enable = false end
		self.isOpen = false
		self.isPending = false
		self.isClosing = false
		self._T.pause = nil
		self._T.player = nil
		self._T.map = nil
		self._T.releaseRequested = false
		local control = _CombatInputController:GetStateControl()
		if isvalid(control) then control:SetPopupInputBlocked(false) end
		if Environment:IsMakerPlay() then log("[VRF] CombatPause popup closed session=" .. tostring(self.popupSession)) end
	end

	@ExecSpace("ClientOnly")
	method void AbortPopup()
		-- 이탈·사망·승인 거부는 콜백 없이 정리하며 이전 세션만 해제 요청한다.
		if isvalid(self._T.pause) then self._T.pause:RequestPopupPause(self.popupSession, false) end
		self:FinishPopup()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 팝업과 맵이 정리되는 순서에 관계없이 소유권과 시간 배율을 복원한다.
		self:AbortPopup()
	end

end
