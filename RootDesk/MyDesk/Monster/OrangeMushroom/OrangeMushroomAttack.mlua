@Component
script OrangeMushroomAttack extends MonsterAttackMotion

	property number JumpHeight = 0.8
	property number JumpDuration = 0.5
	-- 구간별 피격 가능 선언: 접근·복귀 점프 중에는 플레이어의 타격이 막힌다.
	property boolean ApproachHittable = false
	property boolean ReturnHittable = false
	@HideFromInspector
	property Vector2 Home = Vector2(0, 0)
	@HideFromInspector
	property boolean HomeCaptured = false
	@HideFromInspector
	property boolean JumpActive = false
	@HideFromInspector
	property number JumpStartX = 0
	@HideFromInspector
	property number JumpTargetX = 0
	@HideFromInspector
	property number JumpStartTime = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 모션 수명 동안 같은 맵 전투 시계를 재사용한다.
		self._T.pause = self.Entity.CurrentMap:GetComponent("script.CombatPauseComponent")
		self._T.control = self.Entity:GetComponent("script.MonsterStateControl")
	end

	@ExecSpace("ServerOnly")
	method number JumpToLocalX(number targetLocalX)
		-- Preserve the authored arc, rejecting an unready or invalid motion.
		if not self.HomeCaptured or self.JumpDuration <= 0 or self.JumpDuration ~= self.JumpDuration or self.JumpDuration == math.huge then return -1 end
		if not isvalid(self._T.pause) or self._T.pause.IsPaused or not isvalid(self._T.control) then return -1 end
		self.JumpStartX = self.Entity.TransformComponent.Position.x
		self.JumpTargetX = targetLocalX
		self.JumpStartTime = self._T.control:GetActionTime()
		self.JumpActive = true
		self:SetVisualClip("jump")
		return self.JumpDuration
	end

	@ExecSpace("ServerOnly")
	method boolean IsSegmentHittable(string segment)
		-- 접근·복귀 점프 구간의 선언을 이 모션의 속성으로 돌려준다. 그 밖의 구간은 맞는다.
		if segment == "approach" then return self.ApproachHittable end
		if segment == "return" then return self.ReturnHittable end
		return true
	end

	@ExecSpace("ServerOnly")
	method number PerformAttackMotion(string cells, number minX, number maxX)
		-- 주황버섯은 점프 한 번으로 영역 중앙에 착지한다(2칸은 두 칸의 중간, 1칸은 그 칸). 이 규칙은 이 몬스터 모션 한정이다.
		if minX ~= minX or maxX ~= maxX or minX > maxX then return -1 end
		-- Convert the target world X to this entity's parent-local X.
		local transform = self.Entity.TransformComponent
		local targetLocalX = transform.Position.x + (minX + maxX) * 0.5 - transform.WorldPosition.x
		local duration = self:JumpToLocalX(targetLocalX)
		if duration >= 0 then self.Segment = "approach" end
		return duration
	end

	@ExecSpace("ServerOnly")
	method number PerformReturnMotion()
		-- Reuse the same arc to the captured home.
		local duration = self:JumpToLocalX(self.Home.x)
		if duration >= 0 then self.Segment = "return" end
		return duration
	end

	@ExecSpace("ServerOnly")
	method void CompleteMotion()
		-- The timer and update loop converge on one exact endpoint.
		if not self.JumpActive then return end
		self.JumpActive = false
		self.Segment = "none"
		local body = self.Entity.RigidbodyComponent
		if isvalid(body) then body:SetPosition(Vector2(self.JumpTargetX, self.Home.y)) end
		self:SetVisualClip("stand")
	end

	@ExecSpace("ServerOnly")
	method void CancelMotion()
		-- Never write stand over HIT or DEAD while cancelling.
		self.JumpActive = false
		self.Segment = "none"
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- Only an active ATTACK owns continuous arc updates.
		if not isvalid(self._T.pause) or self._T.pause.IsPaused or not isvalid(self._T.control) then return end
		local body = self.Entity.RigidbodyComponent
		if not isvalid(body) then return end
		if not self.HomeCaptured then
			if body:IsOnGround() then
				local position = self.Entity.TransformComponent.Position
				self.Home = Vector2(position.x, position.y)
				self.HomeCaptured = true
			end
			return
		end
		if not self.JumpActive then return end
		local state = self.Entity.StateComponent
		if not isvalid(state) or state.CurrentStateName ~= "ATTACK" then
			self:CancelMotion()
			return
		end
		local t = math.max(0, (self._T.control:GetActionTime() - self.JumpStartTime) / self.JumpDuration)
		if t >= 1 then
			self:CompleteMotion()
			return
		end
		local x = self.JumpStartX + (self.JumpTargetX - self.JumpStartX) * t
		local y = self.Home.y + 4 * self.JumpHeight * t * (1 - t)
		body:SetPosition(Vector2(x, y))
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- Entity teardown must stop any remaining arc.
		self:CancelMotion()
	end

	@ExecSpace("ServerOnly")
	method void OnMapLeave(Entity leftMap)
		-- A motion is meaningful only inside its original map.
		self:CancelMotion()
		self.HomeCaptured = false
		self._T.pause = nil
		self._T.control = nil
	end

end
