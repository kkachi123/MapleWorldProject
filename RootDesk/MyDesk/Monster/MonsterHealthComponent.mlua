@Component
script MonsterHealthComponent extends Component

	@Sync
	property number MaxHp = 100
	@Sync
	property number Hp = 0
	@Sync
	@HideFromInspector
	property boolean IsDead = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 엔티티/로직 수명의 참조와 시작 상태를 초기화한다.
		self.IsDead = false
		self.Hp = self.MaxHp
		local state = self.Entity.StateComponent
		if isvalid(state) then state:DisconnectHitEvent() end
	end

	@ExecSpace("ServerOnly")
	method void ApplyDamage(integer amount)
		-- 최종 몬스터 피해를 한 번 적용하고 사망 상태를 확정한다.
		if self.IsDead or amount < 0 then return end
		self.Hp = math.max(0, self.Hp - amount)
		if self.Hp == 0 then
			self.IsDead = true
			local attack = self.Entity:GetComponent("script.MonsterAttackComponent")
			if isvalid(attack) then attack:CancelPendingAttack() end
			local control = self.Entity:GetComponent("script.MonsterStateControl")
			local stun = self.Entity:GetComponent("script.MonsterStunComponent")
			if isvalid(control) then control:ClearCombatEffects() end
			if isvalid(stun) then stun:ClearStunTimer(); stun:SetStunned(false) end
			-- 사망 경로와 무관하게 서버 표시 클립을 die로 쓴다. 공통 표시 층이 첫 프레임부터 한 번 재생하고 마지막 프레임에서 고정한다(V11-F12).
			---@type MonsterAttackMotion
			local motion = self.Entity:GetComponent(MonsterAttackMotion)
			if isvalid(motion) then motion:SetVisualClip("die") end
			local state = self.Entity.StateComponent
			if isvalid(state) then
				-- 정지 중 비활성 FSM도 사망 전환만 반영한 뒤 기존 활성값을 보존한다.
				local wasEnabled = state.Enable
				if not wasEnabled then state.Enable = true end
				state:ChangeState("DEAD")
				if not wasEnabled then state.Enable = false end
				if Environment:IsMakerPlay() then log("[VRF] MonsterHealth lethal state=" .. state.CurrentStateName .. " enabled=" .. tostring(state.Enable)) end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 사망 표시(die 1회 재생 뒤 마지막 프레임 정지)의 정지 시점만 확인한다.
		if not self.IsDead then return end
		---@type MonsterAttackMotion
		local motion = self.Entity:GetComponent(MonsterAttackMotion)
		if isvalid(motion) then motion:TickDie() end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleHitEvent(HitEvent event)
		-- 네이티브 HitEvent의 최종 피해를 몬스터 HP에 전달한다.
		if self.IsDead then return end
		local amount = event.TotalDamage
		self._T.hitEvents = (self._T.hitEvents or 0) + 1
		self._T.hitEventTotal = (self._T.hitEventTotal or 0) + amount
		self:ApplyDamage(amount)
		local state = self.Entity.StateComponent
		if amount > 0 and not self.IsDead and isvalid(state) and state.CurrentStateName ~= "ATTACK" and state.CurrentStateName ~= "STUN" and state.CurrentStateName ~= "HIT" and state.CurrentStateName ~= "DEAD" then
			state:ChangeState("HIT")
		end
	end

end
