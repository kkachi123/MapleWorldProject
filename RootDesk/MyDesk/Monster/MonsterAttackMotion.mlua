@Component
script MonsterAttackMotion extends Component

	-- 현재 공격 동작 구간: none(공격 동작 밖) / windup(제자리 기 모으기) / approach(실제 점프 접근) / return(복귀). 서버만 정하고 읽는다.
	@HideFromInspector
	property string Segment = "none"
	-- 이펙트 클립 한 개를 둘로 나눠 재생하는 프레임 경계(22.16.4): 0~EffectWindupLastFrame는 공격 시작(눈빛), EffectDustFirstFrame~끝은 판정(먼지). 사이 프레임은 빈 프레임이라 재생하지 않는다.
	property integer EffectWindupLastFrame = 6
	property integer EffectDustFirstFrame = 8

	@ExecSpace("ServerOnly")
	method boolean IsSegmentHittable(string segment)
		-- 선언이 없는 몬스터는 모든 구간에서 맞는다. 몬스터별 모션이 구간별 선언을 덮어쓴다.
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean IsHittableNow()
		-- 플레이어 타격 규칙이 지금 구간의 피격 가능 선언을 묻는 진입점이다.
		return self:IsSegmentHittable(self.Segment)
	end

	@ExecSpace("ServerOnly")
	method void SetVisualClip(string key)
		-- Reuse this monster's existing animation mappings. 접근 클립이 아닌 모든 표시는 배율 1이다.
		self:SetMotionClip(key, 1)
	end

	@ExecSpace("ServerOnly")
	method void SetMotionClip(string key, number motionRate)
		-- 클립 지정의 공통 진입점. 사망 표시가 시작된 뒤에는 어떤 늦은 경로도 클립을 바꾸거나 die를 다시 시작하지 못한다.
		if self._T.dieStarted then return end
		if key == "die" then self:PlayDieOnce(); return end
		local animation = self.Entity.StateAnimationComponent
		local renderer = self.Entity.SpriteRendererComponent
		if not isvalid(animation) or not isvalid(renderer) then return end
		local ruid = animation.ActionSheet[key]
		if ruid == nil or ruid == "" then return end
		-- 프레임 구동(22.16.12)은 접근 클립 한 번의 수명이다. 다른 클립 지정은 구동을 끝낸다.
		self._T.drive = nil
		-- 재스폰 개체의 서버 프레임 범위가 0-0으로 남을 수 있어(22.15) 지정 때마다 끝 프레임을 포함하는 전체 범위로 맞춘 뒤 SpriteRUID를 쓴다(PlayDieOnce와 같은 순서).
		renderer.StartFrameIndex = 0
		renderer.EndFrameIndex = 2147483647
		renderer.SpriteRUID = ruid
		-- 재생 배율 = 그 클립의 배율 x 현재 ActionRate. 슬로우의 저장·복원에는 섞지 않고 매번 이 곱으로 다시 계산한다(22.6).
		self._T.clipRate = motionRate
		self:ApplyClipRate()
		if Environment:IsMakerPlay() then log("[VRF] clip set key=" .. key .. " motionRate=" .. string.format("%g", motionRate) .. " playRate=" .. string.format("%g", renderer.PlayRate) .. " range=" .. tostring(renderer.StartFrameIndex) .. "-" .. tostring(renderer.EndFrameIndex) .. " clock=" .. self:ClockText()) end
	end

	@ExecSpace("ServerOnly")
	method string ClockText()
		-- [VRF]용 맵 전투 시계(정지·슬로우와 무관한 실제 진행 시각)를 문자열로 돌려준다.
		local map = self.Entity.CurrentMap
		local pause = isvalid(map) and map:GetComponent("script.CombatPauseComponent") or nil
		if not isvalid(pause) then return "nil" end
		return string.format("%.3f", pause:GetCombatTime())
	end

	@ExecSpace("ServerOnly")
	method any GetClipTimeline(string key)
		-- 클립의 프레임 수·프레임별 Delay·클립 자체 PlayRate를 서버에서 한 번 읽어 캐시한다(PlayDieOnce와 같은 동기 로드, 스폰 확인 때 채워 진행 중에는 읽지 않는다).
		local animation = self.Entity.StateAnimationComponent
		if not isvalid(animation) then return nil end
		local ruid = animation.ActionSheet[key]
		if ruid == nil or ruid == "" then return nil end
		return self:GetRuidTimeline(ruid)
	end

	@ExecSpace("ServerOnly")
	method any GetRuidTimeline(string ruid)
		-- RUID 한 개의 프레임 표를 읽어 캐시한다(접근 클립과 이펙트 클립이 같은 표를 쓴다).
		self._T.timelines = self._T.timelines or {}
		local cached = self._T.timelines[ruid]
		if cached ~= nil then return cached end
		local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
		if clip == nil or clip.Frames.Count <= 0 then return nil end
		local delays = {}
		for index = 1, clip.Frames.Count do delays[index] = clip.Frames[index].Delay end
		local rate = clip.PlayRate
		if not _CombatRuleCatalog:IsFinite(rate) or rate <= 0 then rate = 1 end
		cached = { count = clip.Frames.Count, delays = delays, rate = rate }
		self._T.timelines[ruid] = cached
		return cached
	end

	@ExecSpace("ServerOnly")
	method any GetWindupSeconds(string key, number frame, number motionRate)
		-- 제자리 시간 W = (f0 ~ f(frame-1) Delay 합) / (클립 자체 PlayRate x 배율). 프레임 번호가 클립 밖이면 nil이다.
		local timeline = self:GetClipTimeline(key)
		if timeline == nil or frame < 0 or frame >= timeline.count then return nil end
		local sum = 0
		for index = 1, frame do sum = sum + timeline.delays[index] end
		return sum / (timeline.rate * motionRate)
	end

	@ExecSpace("ServerOnly")
	method boolean StartDrivenClip(string key, number motionRate)
		-- 접근 클립을 서버가 프레임 단위로 구동한다(22.16.12 후보 1): f0만 고정해 지정하고, 액션 시계가 프레임 경계에 이르면 Start=End=k로 다음 프레임을 고정한다.
		-- 경계가 액션 시계라 슬로우 시작·종료에도 클라이언트 프레임이 되돌아가지 않는다.
		if self._T.dieStarted then return false end
		local renderer = self.Entity.SpriteRendererComponent
		local animation = self.Entity.StateAnimationComponent
		local control = self.Entity:GetComponent("script.MonsterStateControl")
		local timeline = self:GetClipTimeline(key)
		if not isvalid(renderer) or not isvalid(animation) or not isvalid(control) or timeline == nil then return false end
		local bounds = { 0 }
		local divisor = timeline.rate * motionRate
		for index = 1, timeline.count do bounds[index + 1] = bounds[index] + timeline.delays[index] / divisor end
		self._T.drive = { key = key, count = timeline.count, bounds = bounds, start = control:GetActionTime(), frame = 0 }
		-- 클립을 바꾸면 엔진이 프레임 범위를 전체로 되돌리므로(측정) RUID를 먼저 쓰고 그 뒤에 f0 한 프레임만 고정한다. 그 전까지는 f0이 자연 재생되며, 슬로우로 PlayRate가 바뀌어 다시 시작해도 같은 f0이다.
		renderer.SpriteRUID = animation.ActionSheet[key]
		renderer.StartFrameIndex = 0
		renderer.EndFrameIndex = 0
		self._T.clipRate = motionRate
		self:ApplyClipRate()
		if Environment:IsMakerPlay() then log("[VRF] clip driven key=" .. key .. " motionRate=" .. string.format("%g", motionRate) .. " playRate=" .. string.format("%g", renderer.PlayRate) .. " range=" .. tostring(renderer.StartFrameIndex) .. "-" .. tostring(renderer.EndFrameIndex) .. " frames=" .. tostring(timeline.count) .. " clock=" .. self:ClockText()) end
		return true
	end

	@ExecSpace("ServerOnly")
	method void TickClip()
		-- 액션 시계로 지금 있어야 할 프레임까지 올린다. 정지 중에는 액션 시계가 멈춰 진행도 멈추고, 사망 표시 뒤에는 쓰지 않는다.
		local drive = self._T.drive
		if drive == nil or self._T.dieStarted then return end
		local renderer = self.Entity.SpriteRendererComponent
		local control = self.Entity:GetComponent("script.MonsterStateControl")
		if not isvalid(renderer) or not isvalid(control) then return end
		local now = control:GetActionTime() - drive.start
		local target = drive.frame
		while target + 1 < drive.count and now >= drive.bounds[target + 2] do target = target + 1 end
		if target == drive.frame then return end
		drive.frame = target
		-- 늘어나는 방향이라 End를 먼저 올려 Start가 End를 넘는 순간이 없게 한다.
		renderer.EndFrameIndex = target
		renderer.StartFrameIndex = target
		if Environment:IsMakerPlay() then log("[VRF] frame set key=" .. drive.key .. " frame=" .. tostring(target) .. " elapsed=" .. string.format("%.3f", now) .. " clock=" .. self:ClockText()) end
	end

	@ExecSpace("ServerOnly")
	method void StopDrive()
		-- 구동을 끝내고 프레임 범위를 전체로 되돌려 다음 표시(stand·hit)가 고정 프레임에 갇히지 않게 한다. 사망 표시가 시작됐으면 건드리지 않는다.
		if self._T.drive == nil then return end
		self._T.drive = nil
		if self._T.dieStarted then return end
		local renderer = self.Entity.SpriteRendererComponent
		if not isvalid(renderer) then return end
		renderer.StartFrameIndex = 0
		renderer.EndFrameIndex = 2147483647
	end

	@ExecSpace("ServerOnly")
	method void ApplyClipRate()
		-- 렌더러 PlayRate를 "현재 클립 배율 x 현재 ActionRate"로 맞춘다. 사망 표시 뒤에는 쓰지 않는다(die는 배율 1).
		if self._T.dieStarted then return end
		local renderer = self.Entity.SpriteRendererComponent
		if not isvalid(renderer) then return end
		local control = self.Entity:GetComponent("script.MonsterStateControl")
		local actionRate = isvalid(control) and control.ActionRate or 1
		if not _CombatRuleCatalog:IsFinite(actionRate) or actionRate <= 0 then actionRate = 1 end
		local clipRate = self._T.clipRate or 1
		renderer.PlayRate = clipRate * actionRate
	end

	@ExecSpace("ServerOnly")
	method void ResetClipRate()
		-- 접근이 취소되거나 끝나면 다음 표시가 이전 배율을 이어받지 않게 배율 1로 되돌린다.
		self._T.clipRate = 1
		self:StopDrive()
		self:ApplyClipRate()
	end

	@ExecSpace("ServerOnly")
	method void PlayEffectRange(string label, string effectRuid, number x, number y, number motionRate, number firstFrame, number lastFrame)
		-- 이펙트 클립의 한 구간을 고정 위치에 한 번 재생한다. 회전 0·배율 1·반복 없음, 옵션 PlayRate = 그 행 MotionPlayRate x 그 순간 ActionRate.
		local control = self.Entity:GetComponent("script.MonsterStateControl")
		local actionRate = isvalid(control) and control.ActionRate or 1
		if not _CombatRuleCatalog:IsFinite(actionRate) or actionRate <= 0 then actionRate = 1 end
		local options = {}
		options["PlayRate"] = motionRate * actionRate
		options["StartFrameIndex"] = firstFrame
		if lastFrame >= 0 then options["EndFrameIndex"] = lastFrame end
		local serial = _EffectService:PlayEffect(effectRuid, self.Entity, Vector3(x, y, 0), 0, Vector3(1, 1, 1), false, options)
		if Environment:IsMakerPlay() then log("[VRF] effect " .. label .. " ruid=" .. string.sub(effectRuid, 1, 8) .. " x=" .. string.format("%.3f", x) .. " y=" .. string.format("%.3f", y) .. " frames=" .. tostring(firstFrame) .. "-" .. (lastFrame >= 0 and tostring(lastFrame) or "end") .. " playRate=" .. string.format("%g", motionRate * actionRate) .. " serial=" .. tostring(serial) .. " clock=" .. self:ClockText()) end
		self:TrackEffect(label, effectRuid, x, y, motionRate, firstFrame, lastFrame, motionRate * actionRate, serial)
	end

	@ExecSpace("ServerOnly")
	method void TrackEffect(string label, string effectRuid, number x, number y, number motionRate, number firstFrame, number lastFrame, number playRate, integer serial)
		-- 재생 중 이펙트의 시작 상태를 기록해 슬로우 시작·끝에 현재 프레임부터 새 배율로 이어 재생할 수 있게 한다. 팝업 정지는 클라이언트 시간 배율 0이 이미 이펙트를 멈추므로 기록하지 않는다.
		local control = self.Entity:GetComponent("script.MonsterStateControl")
		local timeline = self:GetRuidTimeline(effectRuid)
		if serial == 0 or timeline == nil or not isvalid(control) then return end
		local last = timeline.count - 1
		if lastFrame >= 0 and lastFrame < last then last = lastFrame end
		local now = control:GetActionTime()
		-- 이미 끝난 이펙트는 목록에서 뺀다.
		local kept = {}
		for _, old in ipairs(self._T.fx or {}) do
			if self:GetEffectFrame(old, now) ~= nil then table.insert(kept, old) end
		end
		table.insert(kept, { label = label, ruid = effectRuid, x = x, y = y, motionRate = motionRate, lastOption = lastFrame, lastFrame = last,
			timeline = timeline, startFrame = firstFrame, startAction = now, playRate = playRate, serial = serial })
		self._T.fx = kept
		if Environment:IsMakerPlay() then log("[VRF] effect track " .. label .. " serial=" .. tostring(serial) .. " frames=" .. tostring(firstFrame) .. "-" .. tostring(last) .. " playRate=" .. string.format("%g", playRate) .. " tracked=" .. tostring(#kept) .. " action=" .. string.format("%.3f", now)) end
	end

	@ExecSpace("ServerOnly")
	method any GetEffectFrame(any fx, number now)
		-- 액션 시계(정지·슬로우 반영)로 이 이펙트가 지금 표시 중인 프레임 번호를 계산한다. 재생 구간을 모두 지났으면 nil이다.
		local elapsed = math.max(0, now - fx.startAction) * fx.motionRate
		local frame = fx.startFrame
		while frame <= fx.lastFrame do
			local delay = fx.timeline.delays[frame + 1]
			if elapsed < delay then return frame end
			elapsed = elapsed - delay
			frame = frame + 1
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method void SyncEffectRates()
		-- 슬로우 시작·끝으로 ActionRate가 바뀌면 재생 중 이펙트를 지금 프레임부터 새 배율로 다시 재생한다. 끝난 이펙트는 다시 내지 않고, 배율이 같으면 건드리지 않는다.
		local list = self._T.fx
		if list == nil or #list == 0 then return end
		local control = self.Entity:GetComponent("script.MonsterStateControl")
		if self._T.dieStarted or not isvalid(control) then self:ClearEffects(); return end
		local actionRate = control.ActionRate
		if not _CombatRuleCatalog:IsFinite(actionRate) or actionRate <= 0 then actionRate = 1 end
		local now = control:GetActionTime()
		local kept = {}
		for _, fx in ipairs(list) do
			local frame = self:GetEffectFrame(fx, now)
			if frame == nil then
				if Environment:IsMakerPlay() then log("[VRF] effect skip " .. fx.label .. " serial=" .. tostring(fx.serial) .. " finished action=" .. string.format("%.3f", now)) end
			else
				local newRate = fx.motionRate * actionRate
				if math.abs(newRate - fx.playRate) > 0.000001 then
					_EffectService:RemoveEffect(fx.serial)
					local options = {}
					options["PlayRate"] = newRate
					options["StartFrameIndex"] = frame
					if fx.lastOption >= 0 then options["EndFrameIndex"] = fx.lastOption end
					local serial = _EffectService:PlayEffect(fx.ruid, self.Entity, Vector3(fx.x, fx.y, 0), 0, Vector3(1, 1, 1), false, options)
					if Environment:IsMakerPlay() then log("[VRF] effect rate " .. fx.label .. " frame=" .. tostring(frame) .. " range=" .. tostring(frame) .. "-" .. (fx.lastOption >= 0 and tostring(fx.lastOption) or "end") .. " playRate=" .. string.format("%g", fx.playRate) .. "->" .. string.format("%g", newRate) .. " serial=" .. tostring(fx.serial) .. "->" .. tostring(serial) .. " action=" .. string.format("%.3f", now)) end
					fx.serial = serial
					fx.playRate = newRate
					fx.startFrame = frame
					fx.startAction = now
				end
				if fx.serial ~= 0 then table.insert(kept, fx) end
			end
		end
		self._T.fx = kept
	end

	@ExecSpace("ServerOnly")
	method void ClearEffects()
		-- 대결 종료·사망·이탈·Stop에서 이펙트 추적을 비운다. 이미 재생 중인 이펙트는 마지막 재시작 배율로 끝까지 재생된다.
		local count = self._T.fx ~= nil and #self._T.fx or 0
		self._T.fx = nil
		if count > 0 and Environment:IsMakerPlay() then log("[VRF] effect clear tracked=" .. tostring(count)) end
	end

	@ExecSpace("ServerOnly")
	method void PlayWindupEffect(string effectRuid, number motionRate)
		-- 1단계(눈빛): 공격 시작 때 머쉬맘의 현재 위치(x, 지면 y)에 앞 구간(f0~EffectWindupLastFrame)을 재생한다. 빈 EffectClip이면 호출하지 않는다.
		if effectRuid == nil or effectRuid == "" then return end
		local position = self.Entity.TransformComponent.WorldPosition
		self:PlayEffectRange("windup", effectRuid, position.x, position.y, motionRate, 0, self.EffectWindupLastFrame)
	end

	@ExecSpace("ServerOnly")
	method void PlayDustEffect(string effectRuid, number x, number motionRate)
		-- 2단계(먼지): 판정(착지) 때 착지 x·지면 y에 뒤 구간(EffectDustFirstFrame~끝)을 재생한다. 판정 전에 공격이 취소되면 부르지 않는다.
		if effectRuid == nil or effectRuid == "" then return end
		local position = self.Entity.TransformComponent.WorldPosition
		self:PlayEffectRange("dust", effectRuid, x, position.y, motionRate, self.EffectDustFirstFrame, -1)
	end

	@ExecSpace("ServerOnly")
	method void PlayDieOnce()
		-- 사망 표시: die를 첫 프레임부터 한 번 재생하고 마지막 프레임 시작 시점에 그 프레임으로 고정한다(TickDie).
		if self._T.dieStarted then return end
		local animation = self.Entity.StateAnimationComponent
		local renderer = self.Entity.SpriteRendererComponent
		if not isvalid(animation) or not isvalid(renderer) then return end
		local ruid = animation.ActionSheet["die"]
		if ruid == nil or ruid == "" then return end
		self._T.dieStarted = true
		self._T.drive = nil
		local pause = isvalid(self.Entity.CurrentMap) and self.Entity.CurrentMap:GetComponent("script.CombatPauseComponent") or nil
		local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
		renderer.StartFrameIndex = 0
		renderer.EndFrameIndex = 2147483647
		-- die는 접근 배율·슬로우 배율과 무관하게 배율 1로 재생한다(마지막 프레임 고정 시각 계산도 이 값을 쓴다).
		renderer.PlayRate = 1
		self._T.clipRate = 1
		renderer.SpriteRUID = ruid
		local count = clip ~= nil and clip.Frames.Count or 0
		if count <= 0 or not isvalid(pause) then
			if Environment:IsMakerPlay() then log("[VRF] MonsterDie start without freeze frames=" .. tostring(count)) end
			return
		end
		local total = 0
		for index = 1, count do total = total + clip.Frames[index].Delay end
		local lastDelay = clip.Frames[count].Delay
		local rate = renderer.PlayRate * clip.PlayRate
		if rate <= 0 or rate ~= rate then rate = 1 end
		self._T.diePause = pause
		self._T.dieLastFrame = count - 1
		self._T.dieFreezeAt = pause:GetCombatTime() + (total - lastDelay) / rate
		if Environment:IsMakerPlay() then log("[VRF] MonsterDie start frames=" .. tostring(count) .. " total=" .. string.format("%.3f", total) .. " freezeAfter=" .. string.format("%.3f", (total - lastDelay) / rate) .. " clock=" .. string.format("%.3f", pause:GetCombatTime())) end
	end

	@ExecSpace("ServerOnly")
	method void TickDie()
		-- 맵 전투 시계로 마지막 프레임 시작 시점을 기다린다. 팝업 정지 중에는 시계가 멈춰 남은 재생이 이어진다.
		if not self._T.dieStarted or self._T.dieFrozen or self._T.dieFreezeAt == nil or not isvalid(self._T.diePause) then return end
		local now = self._T.diePause:GetCombatTime()
		if now < self._T.dieFreezeAt then return end
		local renderer = self.Entity.SpriteRendererComponent
		if not isvalid(renderer) then return end
		self._T.dieFrozen = true
		renderer.StartFrameIndex = self._T.dieLastFrame
		renderer.EndFrameIndex = self._T.dieLastFrame
		if Environment:IsMakerPlay() then log("[VRF] MonsterDie freeze frame=" .. tostring(self._T.dieLastFrame) .. " clock=" .. string.format("%.3f", now)) end
	end

	@ExecSpace("ServerOnly")
	method number PerformAttackMotion(string cells, number minX, number maxX, string clip, number motionRate, number landingX, number leadSec, number jumpStartFrame)
		-- The server-fixed area (cell set "111" form + world x range), the pattern's approach clip, play rate and jump start frame,
		-- the server-fixed world landing x and the telegraph lead (= approach time until the judgment) are handed to the monster-specific motion.
		-- A zero-duration base implementation needs no movement.
		return 0
	end

	@ExecSpace("ServerOnly")
	method number PerformReturnMotion()
		-- Subclasses opt into a return movement.
		return 0
	end

	@ExecSpace("ServerOnly")
	method void CompleteMotion()
		-- Subclasses finish their current movement before hit judgment.
	end

	@ExecSpace("ServerOnly")
	method void CancelMotion()
		-- Subclasses release movement without overwriting the next state's clip.
	end

end
