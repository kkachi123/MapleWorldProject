@Logic
script CombatRuleCatalog extends Logic

	property table rules = {}
	property table patterns = {}
	property table warned = {}
	property boolean Ready = false

	method void WarnOnce(string key)
		-- 같은 잘못된 데이터는 세션에서 한 번만 보고한다.
		if self.warned[key] then return end
		self.warned[key] = true
		log_warning("[CombatRuleCatalog] " .. key)
	end

	method boolean IsFinite(any value)
		-- 문자열 원본과 보정 결과의 비정상 수를 같은 기준으로 거부한다.
		return type(value) == "number" and value == value and math.abs(value) < math.huge
	end

	method boolean HasText(any value)
		-- 빈 셀과 공백만 있는 식별자는 유효한 키로 쓰지 않는다.
		return type(value) == "string" and string.find(value, "%S") ~= nil
	end

	method any NormalizeRule(table row)
		-- 정적 기본값과 향후 보정 결과를 동일한 스키마로 검증한다.
		if not self:HasText(row.id) then return nil end
		local data = { id = row.id }
		local fields = {"JustWindowSec", "ParryWindowSec", "GuardDamageRate", "CounterWindowSec", "CounterDamageMultiplier", "SlowDurationSec", "SlowRate", "GroggyDurationSec"}
		for _, key in ipairs(fields) do
			local value = tonumber(row[key])
			if not self:IsFinite(value) or value < 0 then return nil end
			data[key] = value
		end
		if data.GuardDamageRate > 1 or data.CounterDamageMultiplier <= 0 or data.SlowRate <= 0 or data.SlowRate > 1 then return nil end
		return data
	end

	method any ValidateRows(table ruleRows, table patternRows)
		-- 모든 행이 정상일 때만 전체 캐시를 반환해 부분 초기화를 막는다.
		local result = { rules = {}, patterns = {} }
		for _, row in ipairs(ruleRows) do
			local data = self:NormalizeRule(row)
			if data == nil or result.rules[data.id] ~= nil then self:WarnOnce("invalid or duplicate rule"); return nil end
			result.rules[data.id] = data
		end
		local rules = result.rules["default"]
		if rules == nil then self:WarnOnce("default rule missing"); return nil end
		local ids = {}
		for _, row in ipairs(patternRows) do
			if not self:HasText(row.id) or ids[row.id] or not self:HasText(row.modelId) then self:WarnOnce("invalid or duplicate pattern"); return nil end
			if row.ResponseType ~= "LEFT" and row.ResponseType ~= "GUARD" and row.ResponseType ~= "RIGHT" and row.ResponseType ~= "ANY" then self:WarnOnce("invalid response"); return nil end
			if row.AttackAttribute ~= "NORMAL" and row.AttackAttribute ~= "SPECIAL" and row.AttackAttribute ~= "PARRY" then self:WarnOnce("invalid attribute"); return nil end
			if row.AttackAttribute == "SPECIAL" and row.ResponseType == "GUARD" then self:WarnOnce("SPECIAL cannot request GUARD"); return nil end
			local data = { id = row.id, modelId = row.modelId, ResponseType = row.ResponseType, AttackAttribute = row.AttackAttribute }
			for _, key in ipairs({"AreaFromAnchor", "AreaToAnchor", "AreaPaddingX", "AreaHeight", "AreaOffsetY", "TelegraphLeadSec", "Weight"}) do
				local value = tonumber(row[key])
				if not self:IsFinite(value) then self:WarnOnce("invalid pattern number"); return nil end
				data[key] = value
			end
			-- 출현 가중치는 유한한 양수만 허용한다. 끄려면 행을 지운다.
			if data.Weight <= 0 then self:WarnOnce("invalid weight"); return nil end
			-- 대상 칸 방식은 세 값만 허용한다. ANY는 NEAREST/RANDOM, 그 밖의 유형은 FIXED만 짝이 맞는다.
			data.AreaTarget = row.AreaTarget
			if row.AreaTarget ~= "FIXED" and row.AreaTarget ~= "NEAREST" and row.AreaTarget ~= "RANDOM" then self:WarnOnce("invalid area target"); return nil end
			if (row.ResponseType == "ANY") == (row.AreaTarget == "FIXED") then self:WarnOnce("area target does not match response type"); return nil end
			if row.ResponseType == "ANY" then
				-- ANY는 영역 칸을 예고 시작 때 정하므로 앵커 0/0만 허용한다.
				if data.AreaFromAnchor ~= 0 or data.AreaToAnchor ~= 0 then self:WarnOnce("ANY area must be 0/0"); return nil end
			else
				for _, key in ipairs({"AreaFromAnchor", "AreaToAnchor"}) do
					if data[key] < 1 or data[key] > 3 or data[key] ~= math.floor(data[key]) then self:WarnOnce("invalid anchor"); return nil end
				end
				if data.AreaFromAnchor > data.AreaToAnchor then self:WarnOnce("invalid pattern area"); return nil end
			end
			if data.AreaPaddingX < 0 or data.AreaHeight <= 0 or data.TelegraphLeadSec < math.max(rules.JustWindowSec, rules.ParryWindowSec) then self:WarnOnce("invalid pattern area or lead"); return nil end
			ids[data.id] = true
			if result.patterns[data.modelId] == nil then result.patterns[data.modelId] = {} end
			table.insert(result.patterns[data.modelId], data)
		end
		if #patternRows == 0 then self:WarnOnce("patterns missing"); return nil end
		return result
	end

	method any ReadRows(any source, table fields)
		-- 열 누락을 먼저 거부하고 CSV 문자열 행만 읽는다.
		if not isvalid(source) then return nil end
		local columns = {}
		for _, key in ipairs(source.Columns:ToTable()) do columns[key] = true end
		for _, key in ipairs(fields) do if not columns[key] then return nil end end
		local rows = {}
		for index = 1, source:GetRowCount() do
			local row = {}
			for _, key in ipairs(fields) do row[key] = source:GetCell(index, key) end
			table.insert(rows, row)
		end
		return rows
	end

	@ExecSpace("ServerOnly")
	method boolean EnsureInitialized()
		-- 서버 정적 데이터는 한 번 검증하며 실패를 하드코딩 기본값으로 대체하지 않는다.
		if self._T.attempted then return self.Ready end
		self._T.attempted = true
		local ruleRows = self:ReadRows(_DataService:GetTable("CombatRuleData"), {"id", "JustWindowSec", "ParryWindowSec", "GuardDamageRate", "CounterWindowSec", "CounterDamageMultiplier", "SlowDurationSec", "SlowRate", "GroggyDurationSec"})
		local patternRows = self:ReadRows(_DataService:GetTable("MonsterAttackPatternData"), {"id", "modelId", "ResponseType", "AttackAttribute", "AreaFromAnchor", "AreaToAnchor", "AreaPaddingX", "AreaHeight", "AreaOffsetY", "TelegraphLeadSec", "Weight", "AreaTarget"})
		if ruleRows == nil or patternRows == nil then self:WarnOnce("DataSet or required columns missing"); return false end
		local result = self:ValidateRows(ruleRows, patternRows)
		if result == nil then return false end
		self.rules = result.rules
		self.patterns = result.patterns
		self.Ready = true
		if Environment:IsMakerPlay() then log("[VRF] CombatCore catalog ready rules=" .. tostring(#ruleRows) .. " patterns=" .. tostring(#patternRows)) end
		return true
	end

	@ExecSpace("ServerOnly")
	method any GetRules(table modifiers)
		-- 기본값→항등 보정→검증→실행 스냅샷 경계를 제공한다.
		if not self:EnsureInitialized() then return nil end
		local base = self.rules["default"]
		local result = { id = base.id }
		for key, value in pairs(base) do
			if key ~= "id" then
				local factor = modifiers[key]
				if factor == nil then factor = 1 end
				if not self:IsFinite(factor) or factor < 0 then self:WarnOnce("invalid modifier"); return nil end
				result[key] = value * factor
			end
		end
		local valid = self:NormalizeRule(result)
		if valid == nil then self:WarnOnce("invalid modified rule") end
		return valid
	end

	@ExecSpace("ServerOnly")
	method any GetPatterns(string modelId)
		-- 공격자는 이 정적 목록에서 선택한 행을 자기 실행에 복사한다.
		if not self:EnsureInitialized() then return nil end
		local rows = self.patterns[modelId]
		if rows == nil or #rows == 0 then self:WarnOnce("pattern model missing: " .. modelId); return nil end
		return rows
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 컴포넌트 시작 순서와 무관하게 정상 로드도 초기화 시 수행한다.
		self:EnsureInitialized()
	end

	method void OnEndPlay()
		-- 세션 캐시와 경고를 다음 Play에 넘기지 않는다.
		self.rules = {}
		self.patterns = {}
		self.warned = {}
		self.Ready = false
		self._T.attempted = nil
	end

end
