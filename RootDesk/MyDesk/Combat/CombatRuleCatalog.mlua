@Logic
script CombatRuleCatalog extends Logic

	property table rules = {}
	property table patterns = {}
	property table monsterStats = {}
	property table monsterSounds = {}
	property boolean soundsReady = false
	property table warned = {}
	property boolean Ready = false

	method void WarnOnce(string key)
		-- 같은 잘못된 데이터는 세션에서 한 번만 보고한다.
		if self.warned[key] then return end
		self.warned[key] = true
		log_warning("[CombatRuleCatalog] " .. key)
	end

	method boolean IsFinite(any value)
		-- 문자열 원본과 보정 결과의 비정상 수를 같은 기준으로 거부한다.
		return type(value) == "number" and value == value and math.abs(value) < math.huge
	end

	method boolean HasText(any value)
		-- 빈 셀과 공백만 있는 식별자는 유효한 키로 쓰지 않는다.
		return type(value) == "string" and string.find(value, "%S") ~= nil
	end

	method any NormalizeRule(table row)
		-- 정적 기본값과 향후 보정 결과를 동일한 스키마로 검증한다.
		if not self:HasText(row.id) then return nil end
		local data = { id = row.id }
		local fields = {"JustWindowSec", "ParryWindowSec", "GuardDamageRate", "CounterWindowSec", "CounterDamageMultiplier", "SlowDurationSec", "SlowRate", "GroggyDurationSec"}
		for _, key in ipairs(fields) do
			local value = tonumber(row[key])
			if not self:IsFinite(value) or value < 0 then return nil end
			data[key] = value
		end
		if data.GuardDamageRate > 1 or data.CounterDamageMultiplier <= 0 or data.SlowRate <= 0 or data.SlowRate > 1 then return nil end
		return data
	end

	method any ValidateRows(table ruleRows, table patternRows)
		-- 모든 행이 정상일 때만 전체 캐시를 반환해 부분 초기화를 막는다.
		local result = { rules = {}, patterns = {} }
		for _, row in ipairs(ruleRows) do
			local data = self:NormalizeRule(row)
			if data == nil or result.rules[data.id] ~= nil then self:WarnOnce("invalid or duplicate rule"); return nil end
			result.rules[data.id] = data
		end
		local rules = result.rules["default"]
		if rules == nil then self:WarnOnce("default rule missing"); return nil end
		local ids = {}
		for _, row in ipairs(patternRows) do
			if not self:HasText(row.id) or ids[row.id] or not self:HasText(row.modelId) then self:WarnOnce("invalid or duplicate pattern"); return nil end
			if row.ResponseType ~= "LEFT" and row.ResponseType ~= "GUARD" and row.ResponseType ~= "RIGHT" and row.ResponseType ~= "ANY" then self:WarnOnce("invalid response"); return nil end
			if row.AttackAttribute ~= "NORMAL" and row.AttackAttribute ~= "SPECIAL" and row.AttackAttribute ~= "PARRY" then self:WarnOnce("invalid attribute"); return nil end
			if row.AttackAttribute == "SPECIAL" and row.ResponseType == "GUARD" then self:WarnOnce("SPECIAL cannot request GUARD"); return nil end
			local data = { id = row.id, modelId = row.modelId, ResponseType = row.ResponseType, AttackAttribute = row.AttackAttribute }
			for _, key in ipairs({"AreaFromAnchor", "AreaToAnchor", "AreaPaddingX", "AreaHeight", "AreaOffsetY", "TelegraphLeadSec", "Weight"}) do
				local value = tonumber(row[key])
				if not self:IsFinite(value) then self:WarnOnce("invalid pattern number"); return nil end
				data[key] = value
			end
			-- 출현 가중치는 유한한 양수만 허용한다. 끄려면 행을 지운다.
			if data.Weight <= 0 then self:WarnOnce("invalid weight"); return nil end
			-- 대상 칸 방식은 세 값만 허용한다. ANY는 NEAREST/RANDOM, 그 밖의 유형은 FIXED만 짝이 맞는다.
			data.AreaTarget = row.AreaTarget
			if row.AreaTarget ~= "FIXED" and row.AreaTarget ~= "NEAREST" and row.AreaTarget ~= "RANDOM" then self:WarnOnce("invalid area target"); return nil end
			if (row.ResponseType == "ANY") == (row.AreaTarget == "FIXED") then self:WarnOnce("area target does not match response type"); return nil end
			if row.ResponseType == "ANY" then
				-- ANY는 영역 칸을 예고 시작 때 정하므로 앵커 0/0만 허용한다.
				if data.AreaFromAnchor ~= 0 or data.AreaToAnchor ~= 0 then self:WarnOnce("ANY area must be 0/0"); return nil end
			else
				for _, key in ipairs({"AreaFromAnchor", "AreaToAnchor"}) do
					if data[key] < 1 or data[key] > 3 or data[key] ~= math.floor(data[key]) then self:WarnOnce("invalid anchor"); return nil end
				end
				if data.AreaFromAnchor > data.AreaToAnchor then self:WarnOnce("invalid pattern area"); return nil end
			end
			if data.AreaPaddingX < 0 or data.AreaHeight <= 0 or data.TelegraphLeadSec < math.max(rules.JustWindowSec, rules.ParryWindowSec) then self:WarnOnce("invalid pattern area or lead"); return nil end
			-- 연출 열(회차 D). 패턴 표에는 default 행이 없고, 사운드·이펙트 빈 값은 "없음"이며 MotionPlayRate 빈 값은 1이다. 열이 없으면 ReadRows가 이미 표 전체를 거부한다.
			local motionClip = type(row.MotionClip) == "string" and string.match(row.MotionClip, "^%s*(.-)%s*$") or ""
			if motionClip == "" or motionClip == "die" or not string.match(motionClip, "^[a-z][a-z0-9_]*$") then self:WarnOnce("invalid motion clip"); return nil end
			data.MotionClip = motionClip
			local attackSound = self:ParseOptionalRuid(row.AttackSound)
			if attackSound == nil then self:WarnOnce("invalid attack sound ruid"); return nil end
			data.AttackSound = attackSound
			local effectClip = self:ParseOptionalRuid(row.EffectClip)
			if effectClip == nil then self:WarnOnce("invalid effect clip ruid"); return nil end
			data.EffectClip = effectClip
			local rateRaw = row.MotionPlayRate
			local motionRate = 1
			if rateRaw ~= nil and not (type(rateRaw) == "string" and not self:HasText(rateRaw)) then motionRate = tonumber(rateRaw) end
			if not self:IsFinite(motionRate) or motionRate <= 0 then self:WarnOnce("invalid motion play rate"); return nil end
			data.MotionPlayRate = motionRate
			-- 실제 점프가 시작되는 접근 클립 프레임(0부터). 빈 값 = 0 = 시작과 동시에 점프. 프레임 수·제자리 시간과의 관계는 스폰 때 모션 담당이 읽은 클립으로 MonsterManager가 확인한다.
			local frameRaw = row.JumpStartFrame
			local jumpFrame = 0
			if frameRaw ~= nil and not (type(frameRaw) == "string" and not self:HasText(frameRaw)) then jumpFrame = tonumber(frameRaw) end
			if not self:IsFinite(jumpFrame) or jumpFrame < 0 or jumpFrame ~= math.floor(jumpFrame) then self:WarnOnce("invalid jump start frame"); return nil end
			data.JumpStartFrame = jumpFrame
			ids[data.id] = true
			if result.patterns[data.modelId] == nil then result.patterns[data.modelId] = {} end
			table.insert(result.patterns[data.modelId], data)
		end
		if #patternRows == 0 then self:WarnOnce("patterns missing"); return nil end
		return result
	end

	method any ParseOptionalRuid(any raw)
		-- 빈 칸은 "없음"(빈 문자열), 소문자 16진수 32자는 그대로, 그 밖의 형식은 nil(무효)을 돌려준다.
		if raw == nil then return "" end
		if type(raw) ~= "string" then return nil end
		local text = string.match(raw, "^%s*(.-)%s*$")
		if text == "" then return "" end
		if #text == 32 and string.match(text, "^[0-9a-f]+$") ~= nil then return text end
		return nil
	end

	method string FormatWeights(string modelId, table rows)
		-- 한 몬스터 키의 행별 Weight와 비율(%)을 한 줄로 만든다. 같은 행 목록으로 시험 프로브에서도 부를 수 있다.
		local total = 0
		for _, row in ipairs(rows) do total = total + row.Weight end
		local text = "pattern weights " .. modelId .. " total=" .. string.format("%g", total)
		for _, row in ipairs(rows) do
			text = text .. " " .. row.id .. "=" .. string.format("%g", row.Weight) .. "(" .. string.format("%.1f", row.Weight / total * 100) .. "%)"
		end
		return text
	end

	method any ValidateSoundRows(table rows)
		-- 몬스터 키별 사운드 표. default 행이 없고 빈 칸은 무음이다. 하나라도 무효면 표 전체를 거부한다.
		local byId = {}
		for _, row in ipairs(rows) do
			if not self:HasText(row.id) then self:WarnOnce("MonsterSoundData invalid id"); return nil end
			local id = string.match(row.id, "^%s*(.-)%s*$")
			if byId[id] ~= nil then self:WarnOnce("MonsterSoundData duplicate id"); return nil end
			local entry = { id = id }
			for _, key in ipairs({"DamagedSound", "HitPlayerSound", "DieSound"}) do
				local ruid = self:ParseOptionalRuid(row[key])
				if ruid == nil then self:WarnOnce("MonsterSoundData invalid ruid"); return nil end
				entry[key] = ruid
			end
			byId[id] = entry
		end
		return byId
	end

	method boolean IsValidStat(any value, string kind)
		-- 열 종류별 허용 범위: posint=유한한 양의 정수, pos=유한한 양수, nonneg=유한한 0 이상.
		if not self:IsFinite(value) then return false end
		if kind == "posint" then return value > 0 and value == math.floor(value) end
		if kind == "pos" then return value > 0 end
		return value >= 0
	end

	method any ValidateStatRows(string label, table rows, table columns)
		-- 기본값(default) 행 구조의 수치 표를 검증한다. 하나라도 무효면 표 전체를 거부하고 부분 결과를 만들지 않는다.
		local byId = {}
		for _, row in ipairs(rows) do
			if not self:HasText(row.id) then self:WarnOnce(label .. " invalid id"); return nil end
			local id = string.match(row.id, "^%s*(.-)%s*$")
			if byId[id] ~= nil then self:WarnOnce(label .. " duplicate id"); return nil end
			local entry = { id = id, fromDefault = {} }
			for _, column in ipairs(columns) do
				local raw = row[column.key]
				if raw == nil or (type(raw) == "string" and not self:HasText(raw)) then
					-- default 행은 모든 칸이 채워져야 하고 다른 행의 빈 칸만 default 값으로 채운다.
					if id == "default" then self:WarnOnce(label .. " default blank " .. column.key); return nil end
					entry[column.key] = false
				else
					local value = tonumber(raw)
					if not self:IsValidStat(value, column.kind) then self:WarnOnce(label .. " invalid " .. column.key); return nil end
					entry[column.key] = value
				end
			end
			byId[id] = entry
		end
		local base = byId["default"]
		if base == nil then self:WarnOnce(label .. " default row missing"); return nil end
		for _, entry in pairs(byId) do
			for _, column in ipairs(columns) do
				if entry[column.key] == false then
					entry[column.key] = base[column.key]
					entry.fromDefault[column.key] = true
				end
			end
		end
		return byId
	end

	method any ReadRows(any source, table fields)
		-- 열 누락을 먼저 거부하고 CSV 문자열 행만 읽는다.
		if not isvalid(source) then return nil end
		local columns = {}
		for _, key in ipairs(source.Columns:ToTable()) do columns[key] = true end
		for _, key in ipairs(fields) do if not columns[key] then return nil end end
		local rows = {}
		for index = 1, source:GetRowCount() do
			local row = {}
			for _, key in ipairs(fields) do row[key] = source:GetCell(index, key) end
			table.insert(rows, row)
		end
		return rows
	end

	@ExecSpace("ServerOnly")
	method boolean EnsureInitialized()
		-- 서버 정적 데이터는 한 번 검증하며 실패를 하드코딩 기본값으로 대체하지 않는다.
		if self._T.attempted then return self.Ready end
		self._T.attempted = true
		local ruleRows = self:ReadRows(_DataService:GetTable("CombatRuleData"), {"id", "JustWindowSec", "ParryWindowSec", "GuardDamageRate", "CounterWindowSec", "CounterDamageMultiplier", "SlowDurationSec", "SlowRate", "GroggyDurationSec"})
		local patternRows = self:ReadRows(_DataService:GetTable("MonsterAttackPatternData"), {"id", "modelId", "ResponseType", "AttackAttribute", "AreaFromAnchor", "AreaToAnchor", "AreaPaddingX", "AreaHeight", "AreaOffsetY", "TelegraphLeadSec", "Weight", "AreaTarget", "MotionClip", "AttackSound", "EffectClip", "MotionPlayRate", "JumpStartFrame"})
		local statRows = self:ReadRows(_DataService:GetTable("MonsterStatData"), {"id", "MaxHp", "AttackDamage", "AttackInterval"})
		if ruleRows == nil or patternRows == nil then self:WarnOnce("DataSet or required columns missing"); return false end
		if statRows == nil then self:WarnOnce("MonsterStatData missing or required columns missing"); return false end
		local result = self:ValidateRows(ruleRows, patternRows)
		if result == nil then return false end
		local stats = self:ValidateStatRows("MonsterStatData", statRows, {{ key = "MaxHp", kind = "posint" }, { key = "AttackDamage", kind = "nonneg" }, { key = "AttackInterval", kind = "pos" }})
		if stats == nil then return false end
		-- 사운드 표는 몬스터 키별 행이라 표가 무효이거나 없으면 그 표만 거부한다(행을 찾지 못하는 몬스터는 스폰이 거부된다).
		local soundSource = _DataService:GetTable("MonsterSoundData")
		local soundRows = self:ReadRows(soundSource, {"id", "DamagedSound", "HitPlayerSound", "DieSound"})
		local sounds = nil
		if soundRows == nil then self:WarnOnce("MonsterSoundData missing or required columns missing")
		else sounds = self:ValidateSoundRows(soundRows) end
		self.rules = result.rules
		self.patterns = result.patterns
		self.monsterStats = stats
		self.monsterSounds = sounds or {}
		self.soundsReady = sounds ~= nil
		self.Ready = true
		if Environment:IsMakerPlay() then
			log("[VRF] CombatCore catalog ready rules=" .. tostring(#ruleRows) .. " patterns=" .. tostring(#patternRows) .. " monsterStats=" .. tostring(#statRows) .. " monsterSounds=" .. tostring(soundRows ~= nil and #soundRows or -1))
			for modelId, list in pairs(result.patterns) do
				log("[VRF] " .. self:FormatWeights(modelId, list))
				for _, row in ipairs(list) do
					log("[VRF] pattern row id=" .. row.id .. " clip=" .. row.MotionClip .. " rate=" .. string.format("%g", row.MotionPlayRate) .. " jumpFrame=" .. string.format("%g", row.JumpStartFrame) .. " lead=" .. string.format("%g", row.TelegraphLeadSec) .. " sound=" .. (row.AttackSound ~= "" and string.sub(row.AttackSound, 1, 8) or "-") .. " effect=" .. (row.EffectClip ~= "" and string.sub(row.EffectClip, 1, 8) or "-") .. " (no default row, blank = none/rate 1)")
				end
			end
			if soundRows ~= nil and sounds ~= nil then
				for _, row in ipairs(soundRows) do
					local entry = sounds[string.match(row.id, "^%s*(.-)%s*$")]
					log("[VRF] MonsterSoundData id=" .. entry.id .. " damaged=" .. (entry.DamagedSound ~= "" and string.sub(entry.DamagedSound, 1, 8) or "-") .. " hitplayer=" .. (entry.HitPlayerSound ~= "" and string.sub(entry.HitPlayerSound, 1, 8) or "-") .. " die=" .. (entry.DieSound ~= "" and string.sub(entry.DieSound, 1, 8) or "-"))
				end
			end
			for _, row in ipairs(statRows) do
				local entry = stats[string.match(row.id, "^%s*(.-)%s*$")]
				log("[VRF] MonsterStatData id=" .. entry.id .. " MaxHp=" .. tostring(entry.MaxHp) .. " AttackDamage=" .. tostring(entry.AttackDamage) .. " AttackInterval=" .. tostring(entry.AttackInterval) .. " source=DataSet")
			end
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method any GetMonsterStats(string modelKey)
		-- 스폰할 몬스터의 행을 돌려준다. 행이 없거나 예약 행(default)이면 default 값으로 대신하지 않는다.
		if not self:EnsureInitialized() then return nil end
		local row = self.monsterStats[modelKey]
		if row == nil or modelKey == "default" then self:WarnOnce("monster stat row missing: " .. modelKey); return nil end
		return row
	end

	@ExecSpace("ServerOnly")
	method any GetMonsterSounds(string modelKey)
		-- 스폰할 몬스터의 사운드 행을 돌려준다. 표가 무효이거나 행이 없으면 대신할 값 없이 nil과 경고 한 번이다(스폰 거부).
		if not self:EnsureInitialized() then return nil end
		if not self.soundsReady then self:WarnOnce("MonsterSoundData unavailable"); return nil end
		local row = self.monsterSounds[modelKey]
		if row == nil then self:WarnOnce("monster sound row missing: " .. modelKey); return nil end
		return row
	end

	@ExecSpace("ServerOnly")
	method void PlayMonsterSound(string kind, string ruid, Entity player)
		-- 빈 RUID면 호출하지 않는다. 결투 플레이어의 클라이언트에만 음량 1.0으로 재생한다.
		if ruid == nil or ruid == "" then return end
		local userId = ""
		local pc = isvalid(player) and player.PlayerComponent or nil
		if isvalid(pc) then userId = pc.UserId end
		if Environment:IsMakerPlay() then log("[VRF] sfx kind=" .. kind .. " ruid=" .. string.sub(ruid, 1, 8) .. " user=" .. (userId ~= "" and "있음" or "없음")) end
		if userId == "" then return end
		_SoundService:PlaySound(ruid, 1.0, userId)
	end

	@ExecSpace("ServerOnly")
	method any GetRules(table modifiers)
		-- 기본값→항등 보정→검증→실행 스냅샷 경계를 제공한다.
		if not self:EnsureInitialized() then return nil end
		local base = self.rules["default"]
		local result = { id = base.id }
		for key, value in pairs(base) do
			if key ~= "id" then
				local factor = modifiers[key]
				if factor == nil then factor = 1 end
				if not self:IsFinite(factor) or factor < 0 then self:WarnOnce("invalid modifier"); return nil end
				result[key] = value * factor
			end
		end
		local valid = self:NormalizeRule(result)
		if valid == nil then self:WarnOnce("invalid modified rule") end
		return valid
	end

	@ExecSpace("ServerOnly")
	method any GetPatterns(string modelId)
		-- 공격자는 이 정적 목록에서 선택한 행을 자기 실행에 복사한다.
		if not self:EnsureInitialized() then return nil end
		local rows = self.patterns[modelId]
		if rows == nil or #rows == 0 then self:WarnOnce("pattern model missing: " .. modelId); return nil end
		return rows
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 컴포넌트 시작 순서와 무관하게 정상 로드도 초기화 시 수행한다.
		self:EnsureInitialized()
	end

	method void OnEndPlay()
		-- 세션 캐시와 경고를 다음 Play에 넘기지 않는다.
		self.rules = {}
		self.patterns = {}
		self.monsterStats = {}
		self.monsterSounds = {}
		self.soundsReady = false
		self.warned = {}
		self.Ready = false
		self._T.attempted = nil
	end

end
