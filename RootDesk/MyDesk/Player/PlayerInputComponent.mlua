@Component
script PlayerInputComponent extends Component

	@ExecSpace("ClientOnly")
	method string GetAction(KeyboardKey key)
		-- 기존 방향키와 WASD 별칭을 같은 전투 동작으로 변환한다.
		if key == KeyboardKey.UpArrow or key == KeyboardKey.W then return "ATTACK" end
		if key == KeyboardKey.DownArrow or key == KeyboardKey.S then return "GUARD" end
		if key == KeyboardKey.LeftArrow or key == KeyboardKey.A then return "LEFT" end
		if key == KeyboardKey.RightArrow or key == KeyboardKey.D then return "RIGHT" end
		return ""
	end

	@ExecSpace("ClientOnly")
	method any GetStateControl()
		-- 로컬 플레이어의 입력 수락 지점을 수명 동안 재사용한다.
		if self.Entity ~= _UserService.LocalPlayer then return nil end
		if not isvalid(self._T.state) then self._T.state = self.Entity:GetComponent("script.PlayerStateControl") end
		return self._T.state
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleKeyDownEvent(KeyDownEvent event)
		-- 키별 출처를 붙여 입력 수락 지점에 전달한다.
		local action = self:GetAction(event.key)
		if action == "" then return end
		local state = self:GetStateControl()
		if isvalid(state) then state:RequestChangeState(action, "key." .. tostring(event.key)) end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleKeyUpEvent(KeyUpEvent event)
		-- 눌렀던 동일 키 출처만 해제한다.
		local action = self:GetAction(event.key)
		if action == "" then return end
		local state = self:GetStateControl()
		if isvalid(state) then state:ReleaseHeldState(action, "key." .. tostring(event.key)) end
	end

end
