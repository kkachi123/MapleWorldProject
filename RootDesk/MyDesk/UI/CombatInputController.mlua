@Logic
script CombatInputController extends Logic

	property ButtonComponent btnBack = "6327b6bf-3978-4fad-a3d4-9212db316e32"
	property ButtonComponent btnGuard = "3ad5d628-2a6b-4df1-bde4-72ace7fbd0af"
	property ButtonComponent btnForward = "ae5fcd10-999a-4b08-bc7c-d27a5887e5dc"
	property ButtonComponent btnAttack = "c004ea3c-df66-4b82-bed1-d743972d22ff"
	property Entity backHighlight = "93225eff-c809-4bc2-9766-ceaae2f22248"
	property Entity guardHighlight = "f486d930-102c-4a8d-b6c7-610838f049de"
	property Entity forwardHighlight = "c7d65fee-2b24-4ed1-9fad-8198438ece0b"
	property Entity combatGroup = "bd1a3bf8-abe8-4789-833c-f31772e3ff86"

	property TextGUIRendererComponent telegraphText = "fc81f80c-41aa-4be8-bcc2-1bba76e0e15e"
	property TextGUIRendererComponent defenseText = "d664ae7b-e7fc-49f2-a739-49a1759ce402"
	property TextGUIRendererComponent counterText = "b5a57bda-464b-4dbb-96f3-ad9848cc745c"
	property TextGUIRendererComponent effectText = "e6442c55-d5b4-4edb-9eb9-34862fdba146"

	@ExecSpace("ClientOnly")
	method any GetStateControl()
		-- 로컬 플레이어의 입력 수락 지점을 수명 동안 재사용한다.
		local player = _UserService.LocalPlayer
		if self._T.player ~= player then
			self._T.player = player
			self._T.state = nil
		end
		if not isvalid(self._T.state) and isvalid(player) then
			self._T.state = player:GetComponent("script.PlayerStateControl")
		end
		return self._T.state
	end

	@ExecSpace("ClientOnly")
	method void RequestChangeState(string action)
		-- 단일 입력 수락 지점에서 홀드 출처와 실제 상태를 처리한다.
		local state = self:GetStateControl()
		if isvalid(state) then state:RequestChangeState(action, "ui." .. action) end
	end

	@ExecSpace("ClientOnly")
	method void ReleaseHeldState(string action)
		-- 이 출처를 해제하고 마지막 홀드인 경우에만 종료한다.
		local state = self:GetStateControl()
		if isvalid(state) then state:ReleaseHeldState(action, "ui." .. action) end
	end

	@ExecSpace("ClientOnly")
	method void SetInputBlocked(boolean blocked, string source)
		-- 차단 출처를 합산하고 진행 중 홀드 입력을 정리한다.
		local state = self:GetStateControl()
		if isvalid(state) then state:SetInputBlocked(blocked, source) end
	end

	@ExecSpace("ClientOnly")
	method void RefreshVisuals(string action, boolean blocked)
		-- 실제 수락된 동작과 차단 상태를 보조 UI에 반영한다.
		if isvalid(self.backHighlight) then self.backHighlight.Enable = action == "LEFT" end
		if isvalid(self.guardHighlight) then self.guardHighlight.Enable = action == "GUARD" end
		if isvalid(self.forwardHighlight) then self.forwardHighlight.Enable = action == "RIGHT" end
		if isvalid(self.combatGroup) then
			local canvas = self.combatGroup.CanvasGroupComponent
			if isvalid(canvas) then canvas.Interactable = not blocked end
		end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Entity", "6327b6bf-3978-4fad-a3d4-9212db316e32")
	handler HandleBackButtonState(ButtonStateChangeEvent event)
		-- 뒤 회피 버튼의 누름/해제를 UI 출처로 전달한다.
		if event.state == ButtonState.Pressed then self:RequestChangeState("LEFT")
		elseif event.state == ButtonState.Released or event.state == ButtonState.Normal then self:ReleaseHeldState("LEFT") end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Entity", "3ad5d628-2a6b-4df1-bde4-72ace7fbd0af")
	handler HandleGuardButtonState(ButtonStateChangeEvent event)
		-- 가드 버튼의 누름/해제를 UI 출처로 전달한다.
		if event.state == ButtonState.Pressed then self:RequestChangeState("GUARD")
		elseif event.state == ButtonState.Released or event.state == ButtonState.Normal then self:ReleaseHeldState("GUARD") end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Entity", "ae5fcd10-999a-4b08-bc7c-d27a5887e5dc")
	handler HandleForwardButtonState(ButtonStateChangeEvent event)
		-- 앞 회피 버튼의 누름/해제를 UI 출처로 전달한다.
		if event.state == ButtonState.Pressed then self:RequestChangeState("RIGHT")
		elseif event.state == ButtonState.Released or event.state == ButtonState.Normal then self:ReleaseHeldState("RIGHT") end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Entity", "c004ea3c-df66-4b82-bed1-d743972d22ff")
	handler HandleAttackButtonClick(ButtonClickEvent event)
		-- 단발 공격 클릭을 입력 수락 지점에 전달한다.
		self:RequestChangeState("ATTACK")
	end


	@ExecSpace("ClientOnly")
	method void SetSignal(TextGUIRendererComponent label, string text, Color color)
		-- 서버가 확정한 표시가 달라질 때만 클라이언트 텍스트를 갱신한다.
		if not isvalid(label) then return end
		if label.Text ~= text then label.Text = text end
		if label.FontColor ~= color then label.FontColor = color end
	end

	@ExecSpace("ClientOnly")
	method void ClearSignals()
		-- 대결 수명이 없을 때 이전 예고·성공·보너스 표시를 남기지 않는다.
		local white = Color(1, 1, 1, 1)
		self:SetSignal(self.telegraphText, "", white)
		self:SetSignal(self.defenseText, "", white)
		self:SetSignal(self.counterText, "", white)
		self:SetSignal(self.effectText, "", white)
		self._T.feedbackSequence = nil
		self._T.feedbackUntil = nil
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 표시 바인딩과 클라이언트 시작의 양성 근거를 남긴다.
		self:ClearSignals()
		if Environment:IsMakerPlay() then log("[VRF] CombatCore HUD boot bound=" .. tostring(isvalid(self.telegraphText) and isvalid(self.defenseText) and isvalid(self.counterText) and isvalid(self.effectText))) end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 로컬 소유 대결의 동기화 결과만 표시하며 게임 판정은 수행하지 않는다.
		local player = _UserService.LocalPlayer
		local map = isvalid(player) and player.CurrentMap or nil
		if self._T.signalPlayer ~= player or self._T.signalMap ~= map then
			self:ClearSignals()
			self._T.signalPlayer = player
			self._T.signalMap = map
			local managerEntity = isvalid(map) and map:GetChildByName("MonsterManager", false) or nil
			self._T.signalManager = isvalid(managerEntity) and managerEntity:GetComponent("script.MonsterManager") or nil
		end
		local manager = self._T.signalManager
		local monster = isvalid(manager) and manager.CurrentMonster or nil
		if not isvalid(player) or not isvalid(monster) or manager.CurrentPlayer ~= player or monster.CurrentMap ~= map then self:ClearSignals(); return end
		local combat = player:GetComponent("script.PlayerCombatComponent")
		local attack = monster:GetComponent("script.MonsterAttackComponent")
		local control = monster:GetComponent("script.MonsterStateControl")
		local stun = monster:GetComponent("script.MonsterStunComponent")
		local pause = map:GetComponent("script.CombatPauseComponent")
		if not isvalid(combat) or not isvalid(attack) or not isvalid(pause) then self:ClearSignals(); return end
		local text = ""
		local color = Color(1, 1, 1, 1)
		-- 공격 예고 문구는 표시하지 않는다. 방향은 칸 위치, 속성은 칸 색이 알린다(AttackAreaMarkComponent).
		self:SetSignal(self.telegraphText, text, color)
		if self._T.feedbackSequence ~= combat.DefenseFeedbackSequence then
			self._T.feedbackSequence = combat.DefenseFeedbackSequence
			self._T.feedbackUntil = pause:GetCombatTime() + 1
			if Environment:IsMakerPlay() and combat.DefenseFeedback ~= "" then log("[VRF] CombatCore HUD feedback=" .. combat.DefenseFeedback) end
		end
		local feedback = ""
		color = Color(1, 1, 1, 1)
		if pause:GetCombatTime() < (self._T.feedbackUntil or -1) then
			local kind = combat.DefenseFeedback
			if kind == "JUST" then feedback = "저스트 회피 성공"; color = Color(0.48, 0.91, 1, 1)
			elseif kind == "PARRY" then feedback = "패링 성공"; color = Color(0.88, 0.65, 1, 1)
			elseif kind == "GUARD" then feedback = "가드 · 피해 경감"; color = Color(0.65, 0.83, 1, 1)
			elseif kind == "EVADE" then feedback = "회피"; color = Color(0.65, 0.83, 1, 1)
			elseif kind == "HIT" then feedback = "피격"; color = Color(1, 0.43, 0.36, 1) end
		end
		self:SetSignal(self.defenseText, feedback, color)
		self:SetSignal(self.counterText, combat.CounterReady and "반격 준비 · 다음 직접 공격 강화" or "", Color(1, 0.88, 0.42, 1))
		text = ""
		if isvalid(stun) and stun.GroggyRemaining > 0 then text = "상대 그로기" end
		if isvalid(control) and control.SlowRemaining > 0 then text = text == "" and "상대 슬로우" or text .. " · 슬로우" end
		self:SetSignal(self.effectText, text, Color(0.6, 0.88, 1, 1))
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 종료 시 소유한 타이머와 참조를 해제한다.
		self._T.player = nil
		self._T.state = nil
		self:ClearSignals()
		self._T.signalPlayer = nil
		self._T.signalMap = nil
		self._T.signalManager = nil
	end

end
